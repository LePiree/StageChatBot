{
  "title": "Wedding Chatbot — Monitoring Modèle",
  "uid": "chatbot-model",
  "schemaVersion": 38,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requêtes réussies (total)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "chat_requests_total{status=\"success\"}",
        "legendFormat": "succès"
      }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Erreurs Ollama (total)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "chat_requests_total{status=\"error\"}",
        "legendFormat": "erreurs"
      }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tokens générés (total)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "chat_tokens_generated_total",
        "legendFormat": "tokens"
      }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Temps de réponse Ollama (p50 / p95 / p99)",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(chat_duration_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(chat_duration_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(chat_duration_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Taux de requêtes par statut (req/min)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(chat_requests_total{status=\"success\"}[1m]) * 60",
          "legendFormat": "succès / min"
        },
        {
          "expr": "rate(chat_requests_total{status=\"error\"}[1m]) * 60",
          "legendFormat": "erreurs / min"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tokens générés par minute",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [{
        "expr": "rate(chat_tokens_generated_total[1m]) * 60",
        "legendFormat": "tokens / min"
      }]
    }
  ]
}
